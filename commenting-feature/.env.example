# Required env vars for the commenting backend.
#
# Set these in Vercel (Production, Preview, AND Development) — do NOT
# commit real values. For local dev, run `vercel env pull .env.local`
# after setting them in the dashboard. Make sure `.env*.local` is in
# .gitignore.

# Auto-injected by Vercel when you connect an Upstash Redis store via
# Storage → Create Database → Upstash for Redis.
KV_REST_API_URL=https://<your-store>.upstash.io
KV_REST_API_TOKEN=<auto-generated>

# Shared bearer token required for all write operations
# (POST / PATCH / DELETE). Anyone with this string can write; anyone
# without it can only read. Generate with e.g. `openssl rand -hex 24`.
COMMENT_WRITE_TOKEN=<your-secret-here>

# Optional — set per branch automatically by Vercel for git-linked
# deployments. Used to isolate comments per branch. Falls back to
# "local" when unset (i.e. during `vercel dev`).
# VERCEL_GIT_COMMIT_REF=main
